# Oppaan (tekoälyn) avain. Ei koskaan versionhallintaan.
ANTHROPIC_API_KEY=

# Oppaan ääni (Azure AI Speech). Ilman näitä käytetään selaimen omaa ääntä.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Valinnainen: äänen vaihto, esim. fi-FI-NooraNeural tai en-GB-SoniaNeural.
AZURE_SPEECH_VOICE_FI=
AZURE_SPEECH_VOICE_EN=

# Tilit (rekisteröityminen sähköpostilla). Ilman näitä sovellus toimii ilman kirjautumista.
# Allekirjoitusavain kirjautumisevästeelle: vähintään 32 satunnaista merkkiä.
SESSION_SECRET=
# Azure Storage -tilin yhteysmerkkijono (tilit ja kirjautumiskoodit Table Storageen).
AZURE_STORAGE_CONNECTION_STRING=
# Azure Communication Services -sähköposti: yhteysmerkkijono ja lähettäjän osoite.
ACS_CONNECTION_STRING=
ACS_SENDER=
# Vain paikalliseen kehitykseen: tilit muistiin ja koodi palvelimen konsoliin.
# USVA_DEV_AUTH=1
